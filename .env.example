VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ============================================================================
# Telemetria — Phase 2 W1b (TEL-01..TEL-03)
# ----------------------------------------------------------------------------
# These three VITE_* vars are PUBLISH-SAFE (NOT secrets):
#   - PostHog project keys are client-side identifiers, gated by EU project ACL.
#   - Sentry DSNs are publish-safe per Sentry docs (ingest rate-limited per DSN).
# They are NOT covered by FORBIDDEN_VITE_PATTERNS in vite.config.ts.
#
# Values land in Vercel env config (W1c). Leave blank locally to disable
# the telemetry init (graceful no-op via initPosthog/initSentry guards).
# ============================================================================

# PostHog Cloud EU project key (LGPD-friendly region)
VITE_POSTHOG_KEY=""

# PostHog EU ingest host (override only for self-hosted; default is EU cloud)
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# Sentry DSN (https://<hash>@oXXX.ingest.sentry.io/<project-id>)
VITE_SENTRY_DSN=""

# ============================================================================
# Helpdesk + Email — Phase 2 W1c (LAUNCH-05 / D-23 + D-24)
# ----------------------------------------------------------------------------
# VITE_CRISP_WEBSITE_ID is publish-safe per Crisp docs (just identifies the
# website; no ACL bypass possible). RESEND_API_KEY is SERVER-SIDE only —
# never expose to the browser; set via `supabase secrets set` on production.
# ============================================================================

# Crisp Website ID — from Crisp Dashboard → Settings → Setup instructions
VITE_CRISP_WEBSITE_ID=""

# Resend API key — server-side (Deno edge runtime). Set via:
#   `supabase secrets set RESEND_API_KEY=<value>`
# Never copied into VITE_* (would trip failOnSecretLeak() build guard).
RESEND_API_KEY=""

# ============================================================================
# Asaas (gateway de pagamento) — Phase 2 W2a/W2b/W3 (PAY-01..PAY-08)
# ----------------------------------------------------------------------------
# IMPORTANTE: Asaas secrets are server-side ONLY. Set via Lovable Cloud chat
#   `Set edge function secrets: ASAAS_API_KEY=..., ASAAS_WEBHOOK_TOKEN=..., ASAAS_ENV=...`
# NEVER copy into VITE_* prefix — vite.config.ts FORBIDDEN_VITE_PATTERNS
# would trip the build guard.
#
# - ASAAS_API_KEY            — production token starts with $aact_prod_*
# - ASAAS_WEBHOOK_TOKEN      — 64-char hex (openssl rand -hex 32)
# - ASAAS_ENV                — 'sandbox' or 'production'
# - ASAAS_RECONCILE_AUTH_TOKEN — bearer token for the reconcile cron (W2a)
# - ASAAS_INVOICE_ENABLED    — optional kill-switch (default ON); set
#                              'false' to suppress NFS-e auto-issuance
#                              while municipal setup is pending (PAY-08).
#
# Cutover runbook: .planning/phases/02-monetiza-o-compliance-telemetria/02-07-CUTOVER-RUNBOOK.md
# NFS-e setup:     .planning/phases/02-monetiza-o-compliance-telemetria/02-07-NFSE-MUNICIPAL-SETUP.md
# ============================================================================

# subscription_leads é SHADOW LOG (D-11) — desativado por default em produção.
# Para reativar localmente (debug do fallback path), set true em .env.local
# (NÃO em .env.example commitado):
# VITE_ENABLE_SUBSCRIPTION_LEADS="false"
